# Callback server
CALLBACK_HOST=127.0.0.1
CALLBACK_PORT=8787
EVENTS_PORT=8788
EVENTS_DATABASE_PATH=./data/events.sqlite

# Zoom Marketplace app → Feature → Event Subscriptions → Secret Token.
ZOOM_WEBHOOK_SECRET=replace-me

# General Zoom app (user OAuth) for listing/downloading cloud recordings.
# Client values come from the app's App Credentials page; redirect URI must
# match the app's OAuth Redirect URL. Tokens persist in ZOOM_OAUTH_STORE_PATH
# (0600 file, gitignored via data/). ZOOM_ACCOUNT_ID is a retired
# Server-to-Server remnant and is not read — remove it if present.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_TOKEN_URL=https://zoom.us/oauth/token
ZOOM_REDIRECT_URI=https://dev-callbacks.arcturus-labs.com/zoom/oauth
ZOOM_OAUTH_STORE_PATH=./data/zoom-oauth.json

# LinkedIn profile lookups for Peeps person notes. The transcript Pi calls the
# Peeps skill's scripts/get_linkedin_profile.py, which reads LINKEDAPI_API_KEY
# from its own environment. Get a key at https://linkedapi.io (paid API;
# dashboard shows usage) and either add it here so Pi jobs inherit it, or put
# LINKEDAPI_API_KEY=... in the skill's own .env / shell exports.
LINKEDAPI_API_KEY=

# Pi transcript processor. Pi's configured default model is used when PI_MODEL
# is blank; set it to a fully qualified Pi model ID to pin a specific model.
PI_CLI_PATH=pi
PI_MODEL=
PI_SESSION_TITLE_PREFIX=Zoom transcript
DEEPSEEK_API_KEY=
PI_TIMEOUT_MS=600000
# Silence ceiling before a quiet Pi job is treated as stalled (10 min).
PI_IDLE_TIMEOUT_MS=600000
# Total tries per meeting including the first; failures wait PI_RETRY_DELAY_MS.
PI_MAX_ATTEMPTS=2
PI_RETRY_DELAY_MS=60000

# Pi loads the how-to-use-peeps-obsidian skill from this directory.
PI_SKILLS_ROOT=/Users/johnberryman/projects/github/JnBrymn/agent-skills/skills

# These JSONL files are append-only. Pi stdout/stderr and failures go to the
# execution log; successful, completed transcript jobs go to the success log.
PI_EXECUTION_LOG_PATH=./logs/zoom-transcript-pi.jsonl
ZOOM_SUCCESS_LOG_PATH=./logs/zoom-transcript-success.jsonl

# Pi downloads each transcript into an isolated, private job directory.
PI_WORK_ROOT=/private/tmp/zoom-transcript-callback

# Request validation
MAX_WEBHOOK_BODY_BYTES=262144
MAX_WEBHOOK_AGE_SECONDS=300
