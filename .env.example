# Callback server
CALLBACK_HOST=127.0.0.1
CALLBACK_PORT=8787

# Zoom Marketplace app → Feature → Event Subscriptions → Secret Token.
ZOOM_WEBHOOK_SECRET=replace-me

# Local Rook connection
ROOK_SERVER_URL=http://127.0.0.1:7665
ROOK_AUTH_TOKEN=replace-me
ROOK_CLI_PATH=rook
ROOK_RUNTIME_ID=MyPiOpenAiAgent
ROOK_SESSION_TITLE_PREFIX=Zoom
ROOK_ENVIRONMENTS=mac:md.obsidian/MyVault

# Request validation
MAX_WEBHOOK_BODY_BYTES=262144
MAX_WEBHOOK_AGE_SECONDS=300
