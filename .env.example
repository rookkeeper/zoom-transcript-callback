# Callback server
CALLBACK_HOST=127.0.0.1
CALLBACK_PORT=8787

# Zoom Marketplace app → Feature → Event Subscriptions → Secret Token.
ZOOM_WEBHOOK_SECRET=replace-me

# Pi transcript processor. Pi's configured default model is used when PI_MODEL
# is blank; set it to a fully qualified Pi model ID to pin a specific model.
PI_CLI_PATH=pi
PI_PATH_PREFIX=/Applications/Obsidian.app/Contents/MacOS
PI_MODEL=
PI_SESSION_TITLE_PREFIX=Zoom transcript
DEEPSEEK_API_KEY=
PI_TIMEOUT_MS=600000

# Pi loads the how-to-use-peeps-obsidian skill from this directory.
PI_SKILLS_ROOT=/Users/johnberryman/projects/github/JnBrymn/agent-skills/skills

# These JSONL files are append-only. Pi stdout/stderr and failures go to the
# execution log; successful, completed transcript jobs go to the success log.
PI_EXECUTION_LOG_PATH=./logs/zoom-transcript-pi.jsonl
ZOOM_SUCCESS_LOG_PATH=./logs/zoom-transcript-success.jsonl

# Pi downloads each transcript into an isolated, private job directory.
PI_WORK_ROOT=/private/tmp/zoom-transcript-callback

# Request validation
MAX_WEBHOOK_BODY_BYTES=262144
MAX_WEBHOOK_AGE_SECONDS=300
